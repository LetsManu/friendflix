{
  "name": "@friendflix/web",
  "version": "2.4.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/i18n": "./src/lib/i18n/index.ts",
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error && svelte-check --tsconfig ./src/service-worker/tsconfig.json --threshold error",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hls.js": "^1.7.4",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
