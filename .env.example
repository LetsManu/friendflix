# Copy to .env and fill in. NEVER commit .env.
# Secrets may alternatively be provided as Docker secrets via VAR_FILE=/run/secrets/name.

PUBLIC_URL=https://portal.example.com
# NPM reaches the portal on these host ports (bound to BIND_ADDR only, default loopback)
BIND_ADDR=127.0.0.1
WEB_PORT=3080
BACKEND_PORT=3081
GATEWAY_PORT=3082

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Authentik (OIDC provider "FriendFlix", redirect URI: ${PUBLIC_URL}/auth/callback)
OIDC_ISSUER=https://auth.example.com/application/o/friendflix/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Jellyfin (internal URL on the media network) + admin API key (Dashboard -> API Keys)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_ADMIN_API_KEY=

# Seerr (used from step 4)
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

# --- added in step 2+ ---
# openssl rand -base64 32   (encrypts Jellyfin passwords/tokens at rest; losing it = re-provision users)
APP_ENC_KEY=
# openssl rand -hex 24
INTERNAL_SECRET=
WEBHOOK_SECRET=
# Authentik group whose members become portal admins on first login
ADMIN_GROUP=friendflix-admins
# Optional notifications / monitoring
NTFY_URL=
DISCORD_WEBHOOK_URL=
# Persönliche ntfy-Themen (Einstellungen): Basis-URL des ntfy-Servers, sonst der Host von NTFY_URL
NTFY_BASE_URL=
# Web-Push (Browser-Benachrichtigungen, Einstellungen -> Benachrichtigungen). Schlüssel erzeugen: node scripts/gen-vapid.mjs
# (oder: npx web-push generate-vapid-keys). Aktiv nur, wenn beide Schlüssel gesetzt sind. Subject: mailto:... oder https://..., Standard PUBLIC_URL
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Wochenrückblick: Wochentag (0 = Sonntag ... 6 = Samstag) und Serverstunde (0-23, -1 = aus); im Admin-Bereich überschreibbar
# Time zone of the backend (digest hour, nightly playback check hour)
TZ=Europe/Vienna
DIGEST_DAY=0
DIGEST_HOUR=18
# Chromecast-Senden (nur mit https PUBLIC_URL und der Location /media/c/ aus deploy/npm/portal.advanced.conf; bei Plan B auf false). docs/cast.md
CAST_ENABLED=true
METRICS_TOKEN=
# Optional but recommended: portal invites also create the Authentik account (enrollment flow + MFA).
# All three must be set, see docs/integrations.md "Invitations with account creation".
# public Authentik base URL, e.g. https://auth.example.com
AUTHENTIK_URL=
# API token (intent "API") of a user allowed to add invitations
AUTHENTIK_API_TOKEN=
# slug of the enrollment flow, e.g. friendflix-enrollment
AUTHENTIK_ENROLL_FLOW=

# Sessions: absolute 8 h (SESSION_TTL_SECONDS=28800), expire after 2 h without activity:
SESSION_IDLE_SECONDS=7200

# Images (compose.prod.yaml): registry owner and tag
FF_REGISTRY=ghcr.io/letsmanu
FF_TAG=latest

# Admin -> Update: one-click redeploy via Portainer (see docs/operations.md "Updates aus dem Portal"). Either the webhook ...
# PORTAINER_WEBHOOK_URL=https://portainer.example.com/api/stacks/webhooks/<uuid>
# ... or the API (access token, stack id from the stack's URL):
# PORTAINER_URL=https://portainer.example.com
# PORTAINER_API_KEY=
# PORTAINER_STACK_ID=
# PORTAINER_ENDPOINT_ID=1
# Version check (defaults shown); the token only raises the GitHub rate limit
# UPDATE_REPO=LetsManu/friendflix
# GITHUB_TOKEN=
