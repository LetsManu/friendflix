# Copy to .env and fill in. NEVER commit .env.
# Secrets may alternatively be provided as Docker secrets via VAR_FILE=/run/secrets/name.

PUBLIC_URL=https://portal.example.com
# Name of the existing Docker network NPM is attached to
NPM_NETWORK=npm_proxy

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Authentik (OIDC provider "FriendFlix", redirect URI: ${PUBLIC_URL}/auth/callback)
OIDC_ISSUER=https://auth.example.com/application/o/friendflix/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Jellyfin (internal URL on the media network) + admin API key (Dashboard -> API Keys)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_ADMIN_API_KEY=

# Seerr (used from step 4)
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

# --- added in step 2+ ---
# openssl rand -base64 32   (encrypts Jellyfin passwords/tokens at rest; losing it = re-provision users)
APP_ENC_KEY=
# openssl rand -hex 24
INTERNAL_SECRET=
WEBHOOK_SECRET=
# Authentik group whose members become portal admins on first login
ADMIN_GROUP=friendflix-admins
# Optional notifications / monitoring
NTFY_URL=
DISCORD_WEBHOOK_URL=
METRICS_TOKEN=
# Optional: create single-use Authentik enrollment invitations together with portal invites
AUTHENTIK_URL=
AUTHENTIK_API_TOKEN=
AUTHENTIK_ENROLL_FLOW=

# Sessions: absolute 8 h (SESSION_TTL_SECONDS=28800), expire after 2 h without activity:
SESSION_IDLE_SECONDS=7200
