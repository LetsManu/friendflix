
# FriendFlix needs NO .env file. Start the stack (docker compose -f compose.prod.yaml up -d), read the setup code from the backend
# log (docker compose -f compose.prod.yaml logs backend | grep "setup code") and finish the setup wizard in the browser
# (docs/setup.md). Every setting lives in the database and is changed under Admin -> Settings; updates are installed from
# Admin -> Update by the updater service (on by default since 2.0).
#
# Any setting can still be set here to lock it: a value in .env wins over the database and shows locked ("From environment") in
# Admin -> Settings. compose passes every Admin -> Settings key through (generated block in compose.prod.yaml); names, defaults and
# meaning: README "Advanced: configure by environment" and docs/setup.md section 15. Copy this file to .env only to pin a value or
# to set one of the environment-only values below, and uncomment only those lines. NEVER commit .env.
# Upgrading from 1.x: docs/setup.md "Upgrade to 2.0" before removing anything (old names that 2.0 no longer reads are listed there).
# Secrets may alternatively be provided as Docker secrets via VAR_FILE=/run/secrets/name (compose.secrets.yaml).

# --- Generated (bootstrap volume). Leave unset on a new install. ---
# Existing installs keep their values here until `docker compose logs bootstrap` shows "from environment" for each
# (removing one earlier generates a new value that does not match the database / the encrypted data).
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# APP_ENC_KEY=
# INTERNAL_SECRET=

# --- Per container (environment only, not in Admin -> Settings) ---
# NPM reaches the portal on these host ports (bound to BIND_ADDR only, default loopback)
# BIND_ADDR=127.0.0.1
# WEB_PORT=3080
# BACKEND_PORT=3081
# GATEWAY_PORT=3082
# Media server: jellyfin (default) or plex. For Plex use compose.plex.yaml (it sets MEDIA_SERVER=plex, docs/plex.md), e.g.
# COMPOSE_FILE=compose.prod.yaml:compose.plex.yaml so that every plain `docker compose ...` names it.
# COMPOSE_FILE=compose.prod.yaml
# Time zone of the backend (digest hour, nightly playback check, automatic updates)
# TZ=Europe/Vienna
# Weekly recap: weekday (0 = Sunday ... 6 = Saturday) and server hour (0-23, -1 = off); Admin -> Digest overrides them
# DIGEST_DAY=0
# DIGEST_HOUR=18
# Where prepared downloads / preview clips live: empty = Docker named volume, or an absolute host folder
# (create it first: mkdir -p /mnt/data/friendflix/downloads && chown 1000:1000 /mnt/data/friendflix/downloads)
# DOWNLOADS_PATH=
# PREVIEWS_PATH=
# Background jobs (download preparation, language index, session polling). Keep true on the single backend.
# BACKGROUND_JOBS=true
# Admin health page: the gateway's internal address (only /health is called)
# GATEWAY_URL=http://gateway:4000
# Development only: accept an http:// OIDC issuer (an Authentik without TLS). Never in production.
# OIDC_ALLOW_INSECURE=false
# Bearer token for /metrics (docs/monitoring.md)
# METRICS_TOKEN=
# Recommendation expert tuning (docs/discovery.md): RECO_W_GENRES, RECO_W_TAGS, RECO_W_STUDIOS, RECO_W_PEOPLE, RECO_W_TEXT,
# RECO_W_NUMERIC, RECO_W_COLLECTION (0-10, 0 = off) and RECO_COEFFS (JSON overrides of the scoring coefficients)
# RECO_COEFFS=

# --- Updater (on by default; docs/setup.md "Updater") ---
# The compose files it recreates the stack with. Unset = the files the stack was last started with (-f ... or COMPOSE_FILE), so
# compose.plex.yaml / compose.secrets.yaml / compose.authentik.yaml are kept automatically. Set it only to force a list; it must
# then name EVERY file of the stack (with Plex: compose.plex.yaml too, a list without it is refused).
# UPDATER_COMPOSE_FILES=compose.prod.yaml,compose.plex.yaml
# Absolute host path of this directory; only needed when compose runs without PWD (e.g. `sudo docker compose ...`, some GUIs)
# UPDATER_PROJECT_DIR=/opt/friendflix
# Repository whose releases the version check reads and whose CI signature the updater requires
# UPDATE_REPO=LetsManu/friendflix
# UPDATER_URL=http://updater:7070

# --- Without the updater only (compose.no-updater.yaml) ---
# The images then follow FF_TAG: latest = stable releases (default), nightly = every green commit on main, 2 / 2.0 / 2.0.0 (or
# sha-<7 hex>) to pin. Switch: change it, then docker compose pull && docker compose up -d (Admin -> Update shows the line).
# With the updater leave FF_TAG unset: the channel is chosen in Admin -> Update. A manual `docker compose up -d` then pulls `latest`;
# on Nightly or a fixed version press "Update now" in Admin -> Update afterwards.
# FF_TAG=latest
# FF_REGISTRY=ghcr.io/letsmanu

# --- Optional compose files ---
# compose.monitoring.yaml (Prometheus + Grafana, docs/monitoring.md); METRICS_TOKEN is required there.
# No default password: Grafana refuses to start without GRAFANA_ADMIN_PASSWORD (used on its first start only).
#GRAFANA_ADMIN_PASSWORD=
#GRAFANA_ADMIN_USER=admin
#GRAFANA_PORT=3083
#GRAFANA_ROOT_URL=https://grafana.example.com/
#GRAFANA_COOKIE_SECURE=true
#PROMETHEUS_RETENTION=30d
# Backups (opt-in sidecar: docker compose --profile backup up -d backup; see docs/operations.md "Backups & Wiederherstellung")
# BACKUP_PATH=./backups          # host dir for the dumps, must be writable by uid 70 (chown 70 backups)
# BACKUP_HOUR=3                  # daily run at this hour (container TZ, see TZ)
# BACKUP_KEEP_DAYS=14            # older dumps are deleted
# BACKUP_RUN_ON_START=false      # true = also dump once when the container starts
# BACKUP_PGPASSWORD_FILE=        # optional: password file inside the container (default: the bootstrap volume's)

# --- Pin a setting (optional; normally set in the wizard or under Admin -> Settings, where every key has its help text) ---
# Uncommenting a line locks that field in Admin -> Settings until you remove it here again and run `docker compose up -d`.
# PUBLIC_URL=https://friend.example.com
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_ADMIN_API_KEY=
# Plex (compose.plex.yaml passes them; address only, for backend AND gateway): PLEX_URL=http://plex.example.com:32400, PLEX_TOKEN=
# (or PLEX_TOKEN_FILE=/run/secrets/plex_token)
# OIDC_ISSUER=https://auth.example.com/application/o/friendflix/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Request service (optional; since 2.0 only these names, the 1.x names are ignored)
# REQUESTS_URL=http://requests:5055
# REQUESTS_API_KEY=
