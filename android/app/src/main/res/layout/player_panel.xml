<!--
  A player panel (PlayerPanel): the dimmed video behind (a tap closes), a bottom sheet with the title, a close button and the
  scrollable content. The sheet is at most 60 % of the screen height on phones (PanelSheet) and 560 dp wide.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/player_panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/player_scrim"
        android:contentDescription="@string/player_close"
        android:focusable="false" />

    <app.friendflix.android.player.panels.PanelSheet
        android:id="@+id/player_panel_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/player_sheet"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/player_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="More" />

            <ImageButton
                android:id="@+id/player_panel_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_close"
                android:src="@drawable/ic_player_close" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/player_panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/player_panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </app.friendflix.android.player.panels.PanelSheet>
</FrameLayout>
