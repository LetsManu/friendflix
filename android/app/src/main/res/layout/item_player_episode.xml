<!-- One row of the Episodes panel (web EpisodesPanel .ep): code, a still for the playing one, name, run time, progress.
     Its background (ripple, or the playing row's box) is set by EpisodesPanel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/ep_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:minWidth="48dp"
        android:textColor="@color/player_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="S1:E2" />

    <FrameLayout
        android:id="@+id/ep_thumb_box"
        android:layout_width="128dp"
        android:layout_height="72dp"
        android:layout_marginEnd="12dp"
        android:background="@color/row_border"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ep_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ep_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            tools:text="Episode name" />

        <TextView
            android:id="@+id/ep_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/player_muted"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="45 min" />

        <ProgressBar
            android:id="@+id/ep_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressBackgroundTint="@color/player_progress_track"
            android:progressTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
