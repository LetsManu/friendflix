<!--
  The start screen (as the LG app's setup page): the FriendFlix title, then one of three sections - checking the stored server,
  the failure card (Retry / Change server) or the address form. Content at most 1100dp wide, centred (TvSetupActivity sets the width).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/tv_setup_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <!-- the FriendFlix mark and name -->
        <TextView
            android:id="@+id/tv_setup_title"
            style="@style/TvText"
            android:layout_marginBottom="24dp"
            android:drawablePadding="20dp"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textSize="48sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/tv_logo" />

        <!-- checking the stored server -->
        <TextView
            android:id="@+id/tv_setup_checking"
            style="@style/TvText"
            android:textSize="32sp"
            android:visibility="gone" />

        <!-- the failure card -->
        <LinearLayout
            android:id="@+id/tv_setup_failure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_setup_failure_text"
                style="@style/TvText"
                android:accessibilityLiveRegion="assertive"
                android:textColor="@color/tv_error" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tv_setup_retry"
                    style="@style/TvButton"
                    android:layout_marginEnd="28dp"
                    android:nextFocusLeft="@id/tv_setup_change"
                    android:nextFocusRight="@id/tv_setup_change"
                    android:nextFocusUp="@id/tv_setup_change"
                    android:nextFocusDown="@id/tv_setup_change"
                    android:text="@string/tv_retry" />

                <Button
                    android:id="@+id/tv_setup_change"
                    style="@style/TvButton"
                    android:nextFocusLeft="@id/tv_setup_retry"
                    android:nextFocusRight="@id/tv_setup_retry"
                    android:nextFocusUp="@id/tv_setup_retry"
                    android:nextFocusDown="@id/tv_setup_retry"
                    android:text="@string/tv_change_server" />
            </LinearLayout>
        </LinearLayout>

        <!-- the address form -->
        <LinearLayout
            android:id="@+id/tv_setup_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_setup_label"
                style="@style/TvText"
                android:layout_marginBottom="12dp"
                android:text="@string/tv_setup_label"
                android:textColor="@color/tv_muted" />

            <EditText
                android:id="@+id/tv_setup_address"
                style="@style/TvText"
                android:background="@drawable/tv_field"
                android:hint="@string/tv_setup_example"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:minHeight="72dp"
                android:nextFocusDown="@id/tv_setup_connect"
                android:paddingStart="28dp"
                android:paddingTop="14dp"
                android:paddingEnd="28dp"
                android:paddingBottom="14dp"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tv_setup_error"
                style="@style/TvText"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="assertive"
                android:textColor="@color/tv_error" />

            <Button
                android:id="@+id/tv_setup_connect"
                style="@style/TvButton"
                android:layout_marginTop="16dp"
                android:nextFocusUp="@id/tv_setup_address"
                android:text="@string/tv_setup_connect" />

            <TextView
                android:id="@+id/tv_setup_hint"
                style="@style/TvText"
                android:layout_marginTop="24dp"
                android:text="@string/tv_setup_hint"
                android:textColor="@color/tv_hint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
