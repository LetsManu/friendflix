<resources>
    <style name="Theme.FriendFlixTv" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="android:textColorPrimary">@color/tv_text</item>
        <item name="android:textColorHint">@color/tv_hint</item>
        <!-- no system focus highlight on top of the app's own focus ring -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- start screen text: TV legible (10-foot), never below 28sp -->
    <style name="TvText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/tv_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textSize">30sp</item>
    </style>
</resources>
