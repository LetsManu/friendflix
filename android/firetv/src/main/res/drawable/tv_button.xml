<!-- A start screen button: dark at rest; focused it fills with the accent and gets a glow ring (as on the LG app). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/tv_button_disabled" />
            <stroke android:width="3dp" android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <solid android:color="@color/tv_accent_glow" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/tv_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="@color/tv_button" />
            </shape>
        </inset>
    </item>
</selector>
