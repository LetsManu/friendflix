+    #[test]
+    fn a_va_driver_without_hdr_tone_mapping_closes_the_vpp_tonemap() {
+        // Not upstream: iHD reports no `VAProcFilterHighDynamicRangeToneMapping`
+        // on some SKUs, and `tonemap_vaapi` then fails at graph configuration.
+        // Dolby Vision profile 8.1 (HDR10 base layer) is the trial's source.
+        let options = EncodingOptions {
+            enable_vpp_tonemapping: true,
+            hardware_acceleration_type: HardwareAccelerationType::qsv,
+            ..EncodingOptions::default()
+        };
+        let s = hdr(VideoRangeType::DoviWithHdr10);
+        let version = FfmpegVersion::with_build(8, 1, 3);
+
+        let unprobed = caps(version, Platform::Linux);
+        assert!(is_intel_vpp_tonemap_available(
+            &unprobed,
+            &options,
+            Some(&s)
+        ));
+
+        let missing = unprobed.with_vaapi_hdr_tonemap_missing(true);
+        assert!(!is_intel_vpp_tonemap_available(
+            &missing,
+            &options,
+            Some(&s)
+        ));
+
+        // Windows tonemaps inside `vpp_qsv`, which the VA probe says nothing
+        // about.
+        let windows = caps(version, Platform::Windows).with_vaapi_hdr_tonemap_missing(true);
+        assert!(is_intel_vpp_tonemap_available(&windows, &options, Some(&s)));
+    }
