+/// The `vaapi=…` device spec a job's `tonemap_vaapi` would run on, or `None`
+/// when no job planned with these options can reach `tonemap_vaapi`.
+///
+/// The QSV spec is the VAAPI half of the job's own `qsv_device_args` (iHD,
+/// then the render node, vendor id or kernel driver), so the probe opens the
+/// device the transcode will. A VAAPI job uses the configured node, as the
+/// driver probes do, and an empty one is refused for the same reason.
+fn hdr_tonemap_device(caps: &FfmpegCapabilities, options: &EncodingOptions) -> Option<String> {
+    if !caps.platform().is_linux()
+        || !caps.supports_hwaccel("vaapi")
+        || !caps.supports_filter("tonemap_vaapi")
+        || !options.enable_vpp_tonemapping
+    {
+        return None;
+    }
+    let args = match options.hardware_acceleration_type {
+        HardwareAccelerationType::vaapi => {
+            let node = options.vaapi_device.as_deref().filter(|n| !n.is_empty())?;
+            return Some(format!("vaapi={VAAPI_ALIAS}:{node}"));
+        }
+        HardwareAccelerationType::qsv => vaapi_device_args(
+            &VaapiDeviceSpec {
+                render_node: RenderNode::resolve(options.qsv_device.as_deref()),
+                driver: Some("iHD"),
+                kernel_driver: Some("i915"),
+                vendor_id: Some(VENDOR_ID_INTEL),
+                src_device_alias: None,
+            },
+            VAAPI_ALIAS,
+            caps.ffmpeg_version(),
+        ),
+        _ => return None,
+    };
+    args.strip_prefix(" -init_hw_device ").map(str::to_owned)
+}
