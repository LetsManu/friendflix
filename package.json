{
  "name": "friendflix",
  "private": true,
  "type": "module",
  "version": "3.1.0",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=22" },
  "workspaces": ["backend", "gateway", "web", "updater"],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "coverage": "npm run coverage --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "spdx:check": "node scripts/spdx.mjs --check",
    "spdx:fix": "node scripts/spdx.mjs --fix",
    "compose:env": "npm run compose:env -w backend",
    "test:tvshared": "node --test tv-shared/*.test.mjs",
    "test:tizen": "node --test tizen/*.test.mjs tizen/scripts/*.test.mjs",
    "test:webos": "node --test webos/*.test.mjs webos/scripts/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": { "minimatch": "11.0.5" }
}
